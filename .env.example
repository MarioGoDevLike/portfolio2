# ─────────────────────────────────────────────────────────────
# AI Site Concierge — Google Gemini (free tier)
# 1. Get a key: https://aistudio.google.com/apikey
# 2. Copy this file to `.env` in the project root
# 3. Paste your key below and restart `npm start`
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
