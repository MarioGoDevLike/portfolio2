rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Contact form submissions — anyone can create, only signed-in admin can read/update.
    match /inquiries/{inquiryId} {
      function isShortString(value, max) {
        return value is string && value.size() > 0 && value.size() <= max;
      }

      function optionalShortString(data, key, max) {
        return !(key in data) || isShortString(data[key], max);
      }

      allow create: if request.resource.data.keys().hasOnly([
            'name', 'email', 'projectType', 'budget', 'timeline', 'message', 'refId', 'status', 'createdAt'
          ])
        && request.resource.data.keys().hasAll([
            'name', 'email', 'projectType', 'message', 'refId', 'status', 'createdAt'
          ])
        && isShortString(request.resource.data.name, 100)
        && isShortString(request.resource.data.email, 200)
        && request.resource.data.email.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+')
        && request.resource.data.projectType in ['mobile', 'web', 'both']
        && isShortString(request.resource.data.message, 5000)
        && optionalShortString(request.resource.data, 'budget', 40)
        && optionalShortString(request.resource.data, 'timeline', 40)
        && isShortString(request.resource.data.refId, 20)
        && request.resource.data.status == 'received'
        && request.resource.data.createdAt == request.time;

      allow read, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
